+def weight_levels() -> dict[str, int]:
+    """hutter-prize E303: per-group weight levels, TFT_WEIGHT_LEVELS="SUBSTR=L,..."
+
+    Each SUBSTR selects the quantized weights whose name contains it (as in
+    scripts/tfeval/perturb.py, e.g. "mlp.down" or "attention.query_projection");
+    L is an odd level count from 5 to 15 (the ints are -(L-1)/2 .. (L-1)/2).
+    Unset: every weight keeps his 15 levels."""
+    raw = os.environ.get("TFT_WEIGHT_LEVELS", "").strip()
+    out: dict[str, int] = {}
+    for item in filter(None, (x.strip() for x in raw.split(","))):
+        sub, _, val = item.partition("=")
+        assert sub and val.isdigit(), "TFT_WEIGHT_LEVELS item %r is not SUBSTR=L" % item
+        levels = int(val)
+        assert levels % 2 == 1 and 5 <= levels <= 15, (
+            "TFT_WEIGHT_LEVELS %s=%d: L must be odd, 5..15 (3 is the ParetoQ path)" % (sub, levels))
+        out[sub] = levels
+    return out
+
+
+def apply_weight_levels(model: torch.nn.Module) -> list[tuple[str, int]]:
+    """set the bucket count of each weight quantizer that TFT_WEIGHT_LEVELS
+    selects; must run after every model change and before the state is loaded
+    (the scale shapes do not depend on the level count, so any state loads)"""
+    levels = weight_levels()
+    if not levels:
+        return []
+    changed = []
+    for name, module in model.named_modules():
+        quantize = getattr(module, "quantize_weight", None)
+        if quantize is None:
+            continue
+        hits = [sub for sub in levels if sub in name + ".weight"]
+        assert len(hits) <= 1, "%s matches several TFT_WEIGHT_LEVELS items: %s" % (name, hits)
+        if hits:
+            assert quantize.quant.buckets == 15, name
+            quantize.quant = replace(quantize.quant, buckets=levels[hits[0]])
+            changed.append((name, levels[hits[0]]))
+    unused = [sub for sub in levels if not any(sub in n + ".weight" for n, _ in changed)]
+    assert not unused, "TFT_WEIGHT_LEVELS items match no quantized weight: %s" % unused
+    return changed
+
